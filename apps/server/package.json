{
  "name": "@orbis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "test": "bun test",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "eval": "evalite run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "trust": "bun src/trust.ts"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.0-rc.113",
    "@effect/sql-sqlite-bun": "4.0.0-rc.113",
    "@orbis/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0-rc.113",
    "evlog": "2.28.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "1.0.0-rc.5-5935859"
  }
}
