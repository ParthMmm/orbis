{
  "name": "@orbis/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http-api": {
      "types": "./dist/http-api.d.ts",
      "import": "./dist/http-api.js"
    },
    "./source-url-cases": {
      "types": "./dist/source-url-cases.d.ts",
      "import": "./dist/source-url-cases.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117"
  }
}
