{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**", "out/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "diagnostics": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": ["ORBIS_DATA_DIR", "ORBIS_PORT"],
  "globalDependencies": ["tsconfig.base.json"]
}
